# Run locally with Python 3.10+ and a rebuilt sandbox image.
HOST=127.0.0.1
PORT=8787
ENABLE_JOB_QUEUE=1
# Use EXTERNAL_WORKER=1 with python3 worker.py for separate execution.
# Public deployment runs curated fixtures only.
PUBLIC_DEMO=1
# Optional operator access token for a private workspace.
# VERSIONBRIDGE_ACCESS_TOKEN=
# Worker-only credentials, never expose to the HTTP service or sandbox.
# VULTR_API_KEY=
# VULTR_MODEL=deepseek-v4.1-flash-1017
# REQUIRE_INFERENCE=1
INFERENCE_BUDGET_USD=5
INFERENCE_DAILY_REQUESTS=30
INFERENCE_INPUT_USD_PER_MILLION=3
INFERENCE_OUTPUT_USD_PER_MILLION=3
