# Include the limit zones at nginx http scope. Replace the example host,
# provision a TLS certificate, then enable this server on the Vultr VM.
limit_req_zone $binary_remote_addr zone=versionbridge_per_ip:10m rate=3r/m;
limit_req_zone $server_name zone=versionbridge_global:1m rate=12r/m;

server {
    listen 443 ssl;
    server_name demo.example.com;
    ssl_certificate /etc/letsencrypt/live/demo.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.com/privkey.pem;
    client_max_body_size 2k;

    location ~ ^/api/(v1/)?(repair|containment|jobs)$ {
        limit_req zone=versionbridge_per_ip burst=2 nodelay;
        limit_req zone=versionbridge_global burst=4 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8787;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
    }
}
