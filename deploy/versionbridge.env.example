# Worker-only configuration for /etc/versionbridge-worker.env.
# The installer creates separate HTTP and worker units.
REQUIRE_INFERENCE=1
VULTR_API_KEY=
VULTR_MODEL=deepseek-v4.1-flash-1017
VERSIONBRIDGE_DB=/var/lib/versionbridge/runs.sqlite3
SANDBOX_LOCATION="Vultr Cloud Compute"
INFERENCE_BUDGET_USD=5
INFERENCE_DAILY_REQUESTS=30
INFERENCE_INPUT_USD_PER_MILLION=3
INFERENCE_OUTPUT_USD_PER_MILLION=3
# Enable only after installing and validating a hardened runtime.
# SANDBOX_RUNTIME=runsc
